{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loja-fpassos-suplementos",
  "main": "src/sync_frontend_v6.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "secrets": {
    "required": [
      "MERCADO_PAGO_ACCESS_TOKEN",
      "MELHOR_ENVIO_CLIENT_SECRET"
    ]
  },
  "vars": {
    "ORIGIN_ZIP": "04236290",
    "FRONTEND_ORIGINS": "https://fpassossuplementos.com.br,https://www.fpassossuplementos.com.br,https://fpassos-suplementos.loja-fpassossuplementos.workers.dev,https://fpassos-suplementos.lincolnmelo2010.workers.dev",
    "MELHOR_ENVIO_USER_AGENT": "FPassos Suplementos (felipefpassos@hotmail.com)",
    "MELHOR_ENVIO_BASE_URL": "https://www.melhorenvio.com.br",
    "MELHOR_ENVIO_CLIENT_ID": "28660",
    "SHIPPING_HANDLING_FEE": "0",
    "SHIPPING_EXTRA_DAYS": "0"
  },
  "kv_namespaces": [
    {
      "binding": "FPASSOS_STORE",
      "id": "d1b6e2832f654ddaad6e9ad1dd48057d"
    },
    {
      "binding": "FPASSOS_FRONTEND_CODE",
      "id": "17798f8b21ad4b6dbbf2776dfefc8cd9"
    }
  ]
}
